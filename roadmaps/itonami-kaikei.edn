{:topology/id :itonami-kaikei
 :topology/version 1
 :topology/title "Itonami Kaikei"
 :topology/objective "Provide trustworthy local-first accounting for people and organizations."
 :topology/operator :cloud-itonami
 :topology/implementation-org :kotoba-lang
 :topology/issue-authority :radicle
 :topology/radicle-repo "rad:z49fRHLK8QqopZhCNdbTWCD8WLpxF"
 :topology/schema
 {:issue/id {:db/unique :db.unique/identity}
  :issue/blocked-by {:db/valueType :db.type/ref
                     :db/cardinality :db.cardinality/many}
  :issue/project {:db/cardinality :db.cardinality/one}
  :issue/status {:db/cardinality :db.cardinality/one}}
 :topology/queries
 {:open-roots
  [:find ?id
   :where
   [?e :issue/id ?id]
   [?e :issue/status :open]
   (not [?e :issue/blocked-by _])]
  :blocked-edges
  [:find ?issue ?blocker
   :where
   [?e :issue/id ?issue]
   [?e :issue/blocked-by ?b]
   [?b :issue/id ?blocker]]
  :project-work
  [:find ?id ?status
   :in $ ?project
   :where
   [?e :issue/id ?id]
   [?e :issue/project ?project]
   [?e :issue/status ?status]]}
